global
    maxconn 10
    tune.bufsize 16384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options prefer-client-ciphers no-sslv3 no-tlsv10 no-tlsv11 no-tlsv12

defaults
    mode http
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    maxconn 10

resolvers mdns
    nameserver mdns1 224.0.0.251:5353
    timeout retry 1s
    hold valid 10s

frontend https_in
    bind *:443 ssl crt /etc/haproxy/certs/site.pem ca-file /etc/haproxy/certs/ca.crt verify optional
    bind *:80

    # =========================================================================
    # SPOE Filter Initialization
    # =========================================================================
    filter spoe engine ip-checker config /etc/haproxy/spoe.d/spoe-engine.cnf

    # Let's Encrypt HTTP-01 challenge routing
    acl is_acme path_beg /.well-known/acme-challenge/
    use_backend acme_backend if is_acme

    # Redirect HTTP to HTTPS
    redirect scheme https code 301 if !{ ssl_fc } !is_acme

    # =========================================================================
    # 1. GeoIP & ASN Whitelisting
    # =========================================================================
    acl is_allowed_geo src -f /etc/haproxy/whitelists/geoip.lst
    acl is_allowed_asn src -f /etc/haproxy/whitelists/asns.lst

    http-request deny status 403 unless is_allowed_geo or is_allowed_asn

    # =========================================================================
    # 2. Hardening & Threat Mitigation (CVE-2026-109618 / CVE-2026-109619)
    # =========================================================================
    http-request del-header Proxy
    http-request del-header X-Powered-By
    http-request del-header X-Original-URL
    http-request del-header X-Rewrite-URL
    
    http-request deny status 413 if { req.body_size gt 8388608 }

    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    http-request set-header X-Real-IP %[src]

    acl cert_valid ssl_c_verify 0
    http-request deny status 403 unless cert_valid

    http-response del-header Server
    http-response del-header X-Powered-By
    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    http-response set-header X-Content-Type-Options "nosniff"
    http-response set-header X-Frame-Options "DENY"

    # Dynamic rules from /etc/haproxy/rules.d/ are injected below at runtime