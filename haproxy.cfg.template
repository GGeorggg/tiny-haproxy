global
    # Binding 80/443 happens as root; HAProxy then drops to this user.
    user haproxy
    group haproxy
    maxconn 10
    tune.bufsize 16384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options prefer-client-ciphers no-sslv3 no-tlsv10 no-tlsv11 no-tlsv12

defaults
    mode http
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    maxconn 10

resolvers mdns
    # avahi2dns (backed by avahi-daemon) answers *.local over plain DNS.
    # Only servers with `resolvers mdns` use it; everything else is unaffected.
    nameserver avahi2dns 127.0.0.1:5354
    accepted_payload_size 512
    resolve_retries 3
    timeout resolve 1s
    timeout retry   1s
    hold valid 10s
    hold nx    5s

frontend https_in
    bind *:443 ssl crt /etc/haproxy/certs/site.pem ca-file /etc/haproxy/certs/ca.crt verify required
    bind *:80

    filter spoe engine ip-checker config /etc/haproxy/spoe.d/spoe-engine.cnf

    acl is_acme path_beg /.well-known/acme-challenge/
    acl is_allowed_geo src -f /etc/haproxy/whitelists/geoip.lst
    acl is_allowed_asn src -f /etc/haproxy/whitelists/asns.lst
    acl cert_valid ssl_c_verify 0

    # HAProxy evaluates http-request rules first, then redirect, then use_backend,
    # regardless of file order, so the rules below are written in that order.
    # ACME HTTP-01 challenges (plain HTTP only, never over TLS) skip the geo deny,
    # because the CA validating the challenge is not on the whitelists.
    http-request deny status 403 unless is_allowed_geo or is_allowed_asn or is_acme !{ ssl_fc }

    http-request del-header Proxy
    http-request del-header X-Powered-By
    http-request del-header X-Original-URL
    http-request del-header X-Rewrite-URL

    http-request deny status 413 if { req.body_size gt 8388608 }

    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    http-request set-header X-Real-IP %[src]

    # mTLS is enforced by 'verify required' on the bind (with 'optional' a client without a
    # certificate still has ssl_c_verify 0). This rule is a second line of defence, and only
    # applies to TLS: plain HTTP is just redirected below.
    http-request deny status 403 if { ssl_fc } !cert_valid

    http-response del-header Server
    http-response del-header X-Powered-By
    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    http-response set-header X-Content-Type-Options "nosniff"
    http-response set-header X-Frame-Options "DENY"

    redirect scheme https code 301 if !{ ssl_fc } !is_acme

    use_backend acme_backend if is_acme !{ ssl_fc }
